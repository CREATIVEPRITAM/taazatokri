rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isDeliveryPartner() {
      return isAuthenticated() && (
        request.auth.token.role == 'delivery_partner' ||
        exists(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid))
      );
    }

    // --- Customers / Users ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'customer';
      allow update: if (isOwner(userId) &&
                        request.resource.data.role == resource.data.role &&
                        request.resource.data.accountStatus == resource.data.accountStatus)
                    || isAdmin();
      allow delete: if isAdmin();

      // Customer Saved Addresses
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- Admins ---
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // --- Delivery Partners ---
    match /deliveryPartners/{partnerId} {
      // Partner can view own profile; Admin manages partners
      allow read: if isOwner(partnerId) || isAdmin();
      allow write: if isAdmin();
    }

    // --- Master Catalog: Categories & Products ---
    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // --- Master Geography: Sectors & Blocks ---
    match /sectors/{sectorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /blocks/{blockId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Banners & Offers ---
    match /banners/{bannerId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.targetAudience == 'all' ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // --- System Settings ---
    match /systemSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Orders ---
    match /orders/{orderId} {
      // Read: Customer owner, Assigned Partner, or Admin
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.assignedPartnerId == request.auth.uid ||
        isAdmin()
      );

      // Create: Admin or via Cloud Function (Direct client writes restricted to initial customer order)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.customerId == request.auth.uid &&
         request.resource.data.orderStatus == 'order_placed')
      );

      // Update:
      // - Admin has operational control
      // - Assigned Delivery Partner can update status (assigned -> out_for_delivery -> delivered / failed)
      // - Customer can cancel only if current status is 'order_placed'
      allow update: if isAuthenticated() && (
        isAdmin() ||
        // Delivery Partner status progression
        (resource.data.assignedPartnerId == request.auth.uid &&
         request.resource.data.items == resource.data.items &&
         request.resource.data.billSummary == resource.data.billSummary &&
         request.resource.data.deliveryAddress == resource.data.deliveryAddress &&
         (request.resource.data.orderStatus in ['out_for_delivery', 'delivered', 'failed'])) ||
        // Customer self-cancellation guard
        (resource.data.customerId == request.auth.uid &&
         resource.data.orderStatus == 'order_placed' &&
         request.resource.data.orderStatus == 'cancelled')
      );

      allow delete: if isAdmin();
    }

    // --- COD Settlement & Partner Payment ---
    match /codSettlements/{settlementId} {
      allow read: if (isAuthenticated() && resource.data.partnerId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /partnerPayments/{paymentId} {
      allow read: if (isAuthenticated() && resource.data.partnerId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
