rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Authentication & Role Helpers ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * Authoritative Admin validation:
     * - Checked via custom claims (admin == true or role == 'admin')
     * - OR existence in the dedicated 'admins/{uid}' collection.
     * Role attributes inside the 'users' collection are NEVER trusted for admin authorization.
     */
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Customers / Users (Dedicated 'users' collection) ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Customer profile creation on signup
      allow create: if isOwner(userId) && request.resource.data.accountStatus == 'active';
      // Customer can update profile, but CANNOT self-promote or modify accountStatus
      allow update: if (isOwner(userId) &&
                        request.resource.data.accountStatus == resource.data.accountStatus)
                    || isAdmin();
      allow delete: if isAdmin();

      // Customer Saved Addresses
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- Admins (Dedicated 'admins' collection) ---
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // --- Delivery Partners (Dedicated 'deliveryPartners' collection) ---
    // Document ID is the partner's Firebase Auth UID (authUid)
    match /deliveryPartners/{partnerUid} {
      allow read: if isOwner(partnerUid) || isAdmin();
      allow write: if isAdmin();
    }

    // --- Master Catalog: Categories & Products ---
    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // --- Master Geography: Sectors & Blocks ---
    match /sectors/{sectorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /blocks/{blockId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Banners & Offers ---
    match /banners/{bannerId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.targetAudience == 'all' ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // --- System Settings ---
    match /systemSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Orders ---
    match /orders/{orderId} {
      // READ: Customer who placed it, Assigned Delivery Partner (via assignedPartnerUid), or Admin
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.assignedPartnerUid == request.auth.uid ||
        isAdmin()
      );

      // CREATE: Strictly DENIED for customers directly!
      // createOrder Cloud Function is the ONLY authoritative write path.
      // Admin SDK in Cloud Functions bypasses rules; direct client creation is blocked.
      allow create: if isAdmin();

      // UPDATE: Strictly DENIED for customers directly!
      // cancelOrder Cloud Function is the ONLY authoritative path for customer cancellations.
      // Assigned Delivery Partner may ONLY update delivery status progression and COD confirmation.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.assignedPartnerUid == request.auth.uid &&
         request.resource.data.customerId == resource.data.customerId &&
         request.resource.data.items == resource.data.items &&
         request.resource.data.billSummary == resource.data.billSummary &&
         request.resource.data.deliveryAddress == resource.data.deliveryAddress &&
         request.resource.data.assignedPartnerUid == resource.data.assignedPartnerUid &&
         (request.resource.data.orderStatus in ['out_for_delivery', 'delivered', 'failed']))
      );

      // DELETE: Admin only (for audit / emergency cleanup)
      allow delete: if isAdmin();
    }

    // --- COD Settlement & Partner Payment ---
    match /codSettlements/{settlementId} {
      allow read: if (isAuthenticated() && resource.data.partnerUid == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /partnerPayments/{paymentId} {
      allow read: if (isAuthenticated() && resource.data.partnerUid == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
