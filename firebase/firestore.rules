rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Authentication & Role Helpers ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * Authoritative Admin validation:
     * - Checked ONLY via dedicated server-issued boolean custom claim (admin == true)
     * - OR existence of the caller's UID in the dedicated 'admins/{uid}' collection.
     * Generic string tokens or user collection roles are NEVER trusted.
     */
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Delivery Partner Order Update Hardening ---
    function isAssignedDeliveryPartner(orderData) {
      return isAuthenticated() && orderData.assignedPartnerUid == request.auth.uid;
    }

    function isDeliveryPartnerOrderUpdateValid() {
      let diff = request.resource.data.diff(resource.data);
      let affectedKeys = diff.affectedKeys();

      // Whitelist of fields Delivery Partner is permitted to modify
      let allowedKeys = [
        'orderStatus',
        'codCollected',
        'failureReason',
        'failureNote',
        'timeline',
        'updatedAt'
      ].toSet();

      let onlyAllowedKeysChanged = affectedKeys.hasOnly(allowedKeys);

      let currentStatus = resource.data.orderStatus;
      let targetStatus = request.resource.data.orderStatus;

      // Enforce explicit state transitions:
      // - assigned/confirmed/order_placed -> out_for_delivery
      // - out_for_delivery -> delivered (requires codCollected == true)
      // - out_for_delivery -> failed (requires approved failureReason)
      let validTransition =
        (currentStatus in ['order_placed', 'confirmed', 'assigned'] && targetStatus == 'out_for_delivery') ||
        (currentStatus == 'out_for_delivery' && targetStatus == 'delivered' && request.resource.data.codCollected == true) ||
        (currentStatus == 'out_for_delivery' && targetStatus == 'failed' &&
         request.resource.data.failureReason in ['customer_unavailable', 'not_reachable', 'address_issue', 'refused', 'other']);

      // All business, financial, and address fields must remain strictly immutable
      let immutableFieldsPreserved =
        request.resource.data.id == resource.data.id &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.assignedPartnerUid == resource.data.assignedPartnerUid &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.billSummary == resource.data.billSummary &&
        request.resource.data.deliveryAddress == resource.data.deliveryAddress &&
        request.resource.data.deliveryDate == resource.data.deliveryDate;

      return onlyAllowedKeysChanged && validTransition && immutableFieldsPreserved;
    }

    // --- Customers / Users (Dedicated 'users' collection) ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Customer profile creation on signup
      allow create: if isOwner(userId) && request.resource.data.accountStatus == 'active';
      // Customer can update profile, but CANNOT self-promote or modify accountStatus
      allow update: if (isOwner(userId) &&
                        request.resource.data.accountStatus == resource.data.accountStatus)
                    || isAdmin();
      allow delete: if isAdmin();

      // Customer Saved Addresses
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- Admins (Dedicated 'admins' collection) ---
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // --- Delivery Partners (Dedicated 'deliveryPartners' collection) ---
    // Document ID is the partner's Firebase Auth UID (authUid)
    match /deliveryPartners/{partnerUid} {
      allow read: if isOwner(partnerUid) || isAdmin();
      allow write: if isAdmin();
    }

    // --- Master Catalog: Categories & Products ---
    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // --- Master Geography: Sectors & Blocks ---
    match /sectors/{sectorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /blocks/{blockId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Banners & Offers ---
    match /banners/{bannerId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.targetAudience == 'all' ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // --- System Settings ---
    match /systemSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Orders ---
    match /orders/{orderId} {
      // READ: Customer owner, Assigned Partner (by assignedPartnerUid), or Admin
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.assignedPartnerUid == request.auth.uid ||
        isAdmin()
      );

      // CREATE: Strictly DENIED for customers directly!
      // createOrder Cloud Function is the ONLY authoritative creation path.
      allow create: if isAdmin();

      // UPDATE: Strictly DENIED for customers directly!
      // cancelOrder Cloud Function is the ONLY authoritative path for customer cancellations.
      // Assigned Delivery Partner may ONLY advance status per strict transition machine & field whitelist.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isAssignedDeliveryPartner(resource.data) && isDeliveryPartnerOrderUpdateValid())
      );

      // DELETE: Admin only (for audit / emergency cleanup)
      allow delete: if isAdmin();
    }

    // --- COD Settlement & Partner Payment ---
    match /codSettlements/{settlementId} {
      allow read: if (isAuthenticated() && resource.data.partnerUid == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /partnerPayments/{paymentId} {
      allow read: if (isAuthenticated() && resource.data.partnerUid == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
